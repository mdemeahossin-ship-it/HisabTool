<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".UI_Fragment.Baki_Taka_Fragment">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="গ্রাহক নির্বাচন করুন"
        android:textSize="@dimen/_13sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_10sdp"
        />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_Input_name"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:hint="গ্রাহকের নাম নির্বাচন করুন"
        android:layout_gravity="center"
        app:errorEnabled="true"

        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="গ্রাহক ফোন নম্বর দিন"
        android:textSize="@dimen/_13sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_10sdp"
        />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_Input_phone"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_3sdp"        android:hint="গ্রাহক ফোন নম্বর দিন"
        android:layout_gravity="center"
        app:errorEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="তারিখ"
        android:textSize="@dimen/_13sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_10sdp"
        />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_Input_Date"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:hint="25 মে 2024"
        android:layout_gravity="center"
        app:errorEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <!--=======================================-->


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="বিবরণ"
        android:textSize="@dimen/_13sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_10sdp"
        />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_Input_details"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:layout_gravity="center"
        android:hint="যেমন। চাল, ডাল, তেল ইত্যাদি"
        app:errorEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />

    </com.google.android.material.textfield.TextInputLayout>

    <!--=======================================-->



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="টাকার পরিমাণ"
        android:textSize="@dimen/_13sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_10sdp"
        />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_Input_amount"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:hint="৮০"
        android:layout_gravity="center"
        app:errorEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <!--=======================================-->



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="আগের বাকি"
        android:textSize="@dimen/_13sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_10sdp"
        />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_Input_rest"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:hint="৮০"
        android:layout_gravity="center"
        app:errorEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_rest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <!--=======================================-->

</LinearLayout>