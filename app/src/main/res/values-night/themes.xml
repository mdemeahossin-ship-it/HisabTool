<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SQLiteDatabase" parent="Theme.Material3.Dark.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="android:statusBarColor">@color/primary</item>

        <item name="actionModeStyle">@style/CustomActionModeStyleNight</item>

    </style>

    <style name="CustomActionModeStyleNight" parent="Widget.AppCompat.ActionMode">
