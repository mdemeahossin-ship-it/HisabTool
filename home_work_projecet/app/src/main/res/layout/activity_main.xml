<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    android:padding="5dp"
    tools:context=".MainActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shape Calculator"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:textColor="@color/black"/>

        <!-- Rectangle Inputs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rectangle (Length &amp; Width):"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_rect_l"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Length"
                android:inputType="numberDecimal"
                android:background="@android:drawable/editbox_background"/>

            <EditText
                android:id="@+id/et_rect_w"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Width"
                android:inputType="numberDecimal"
                android:background="@android:drawable/editbox_background"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_rect_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rectangle result here"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:background="#E8F5E9" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="15dp"/>


        <!-- Circle Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Circle (Radius):"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_circle_r"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Radius"
            android:inputType="numberDecimal"
            android:background="@android:drawable/editbox_background"/>

        <TextView
            android:id="@+id/tv_circle_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Circle result here"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:background="#E3F2FD" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="15dp"/>

        <!-- Triangle Inputs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Triangle (3 Sides):"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_tri_s1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Side 1"
                android:inputType="numberDecimal"
                android:background="@android:drawable/editbox_background"/>

            <EditText
                android:id="@+id/et_tri_s2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Side 2"
                android:inputType="numberDecimal"
                android:background="@android:drawable/editbox_background"/>


            <EditText
                android:id="@+id/et_tri_s3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Side 3"
                android:inputType="numberDecimal"
                android:background="@android:drawable/editbox_background"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_tri_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Triangle result here"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:background="#FFF3E0" />

        <!-- Button -->
        <Button
            android:id="@+id/btn_calculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Now"
            android:layout_marginTop="25dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"/>



    </LinearLayout>
</ScrollView>


